# Copy this file to `.env` (local) or set these in your hosting provider's
# environment settings, then rebuild. All values are public (bundled into the
# frontend) - never put secrets here.

# REQUIRED: Google Apps Script Web App URL (ends with /exec)
VITE_GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXX/exec

# OPTIONAL: override the catalogue PDF URLs.
# Leave empty to use the bundled files in public/catalogues/ (recommended:
# same-origin files give the most reliable download on mobile browsers).
# Google Drive "view" links are converted to direct-download links automatically.
VITE_HOGAR_CATALOGUE_URL=
VITE_DU_CATALOGUE_URL=
